# Copy to eval/.env (gitignored). Only the paid commands and the live tests read it;
# the default test run needs no keys.

# The judge comes from another provider than the generator: gpt-4o-mini answers,
# Claude grades. A same-provider judge (openai, gpt-4o) is flagged in every report.
JUDGE_PROVIDER=anthropic
JUDGE_MODEL=claude-haiku-4-5

ANTHROPIC_API_KEY=
# Synthetic drafts, and a same-provider judge.
OPENAI_API_KEY=

# The services under evaluation.
RAG_URL=http://localhost:8000
AGENT_URL=http://localhost:8080
